APP_ENV=development
DEBUG=false
POSTGRES_DB=scraplink
POSTGRES_USER=scraplink
POSTGRES_PASSWORD=replace_with_your_local_password
# Compose fixes internal database routing to db:5432 and the public URL to localhost:8000.
# Small verified public employer board set; no title or location restrictions.
ASHBY_BOARDS=["ashby"]
GREENHOUSE_BOARDS=["anthropic"]
LEVER_BOARDS=["palantir"]
# USAJOBS is disabled until both are present. Never put these in frontend config.
USAJOBS_EMAIL=
USAJOBS_API_KEY=
